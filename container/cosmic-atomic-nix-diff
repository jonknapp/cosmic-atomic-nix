#!/usr/bin/python3
"""Show the package changes between the booted image and a newer one.

`rpm-ostree upgrade --preview` can only list layer changes for container
images, because the RPM database is inside the layers. This image records its
package list in /usr/share/cosmic-atomic-nix/packages.tsv and the build copies
the same list, gzipped and base64-encoded, into an image label. The label is
part of the image config, so `skopeo inspect` reads it with a few kilobytes of
download instead of pulling the image.

Usage: cosmic-atomic-nix-diff [IMAGE]

IMAGE defaults to the image the booted deployment follows. It can be given as
`ghcr.io/owner/repo:tag`, `docker://...`, or an rpm-ostree reference such as
`ostree-image-signed:docker://...`.

`skopeo inspect` does not check signatures, so the label is only trusted after
`cosign verify` has checked the inspected digest against
/etc/pki/containers/cosign.pub. If cosign is on PATH, a failed verification
is an error and no diff is shown. Without cosign the diff is shown, marked
NOT VERIFIED. Get cosign through Nix, for example:

  nix shell nixpkgs#cosign -c cosmic-atomic-nix-diff
"""

import base64
import binascii
import json
import re
import shutil
import subprocess
import sys
import zlib

# Must match LABEL in scripts/add-package-label.sh.
LABEL = "io.github.cosmic-atomic-nix.packages"
LOCAL_LIST = "/usr/share/cosmic-atomic-nix/packages.tsv"
COSIGN_KEY = "/etc/pki/containers/cosign.pub"

# A real list is about 80 KB (20-30 KB encoded). The limits only stop a forged
# label from exhausting memory, e.g. a small gzip that expands to gigabytes.
MAX_ENCODED = 4 * 1024 * 1024
MAX_LIST = 8 * 1024 * 1024

# `rpm -qa --qf '%{NAME}.%{ARCH}\t%{EVR}\n'`: rpm limits names, versions and
# releases to these characters. Anything else, such as terminal escape
# sequences in a forged label, rejects the whole list.
LINE_RE = re.compile(
    r"(?P<name>[A-Za-z0-9._+^~-]+)\t"
    r"(?P<evr>(?:[0-9]+:)?[A-Za-z0-9._+^~]+-[A-Za-z0-9._+^~]+)"
)
DIGEST_RE = re.compile(r"sha256:[0-9a-f]{64}")


def clean(text):
    """Escape non-printable characters (terminal escapes, newlines)."""
    return "".join(c if c.isprintable() else repr(c)[1:-1] for c in str(text))


def die(msg):
    print(f"cosmic-atomic-nix-diff: {clean(msg)}", file=sys.stderr)
    sys.exit(2)


def to_skopeo_ref(ref):
    """Turn an rpm-ostree image reference into a skopeo transport:name."""
    for prefix in ("ostree-image-signed:", "ostree-unverified-image:"):
        if ref.startswith(prefix):
            ref = ref[len(prefix):]
            break
    else:
        if ref.startswith("ostree-unverified-registry:"):
            ref = "docker://" + ref[len("ostree-unverified-registry:"):]
        elif ref.startswith("ostree-remote-registry:"):
            # ostree-remote-registry:REMOTE:registry/repo:tag
            ref = "docker://" + ref.split(":", 2)[2]
        elif ref.startswith("ostree-remote-image:"):
            # ostree-remote-image:REMOTE:transport:name
            ref = ref.split(":", 2)[2]
    transports = ("docker://", "containers-storage:", "oci:", "oci-archive:",
                  "docker-archive:", "dir:")
    if not ref.startswith(transports):
        ref = "docker://" + ref
    return ref


def repository(ref):
    """docker://host/owner/repo:tag (or @digest) -> host/owner/repo."""
    name = ref[len("docker://"):].split("@", 1)[0]
    slash = name.rfind("/")
    colon = name.rfind(":")
    if colon > slash:
        name = name[:colon]
    return name


def booted_image_ref():
    try:
        out = subprocess.run(
            ["rpm-ostree", "status", "--booted", "--json"],
            check=True, capture_output=True, text=True,
        ).stdout
    except (OSError, subprocess.CalledProcessError) as e:
        die(f"cannot read rpm-ostree status: {e}")
    for dep in json.loads(out).get("deployments", []):
        if dep.get("booted"):
            ref = dep.get("container-image-reference")
            if not ref:
                die("the booted deployment is not a container image; "
                    "pass IMAGE explicitly")
            return ref
    die("no booted deployment found; pass IMAGE explicitly")


def parse(text, source):
    """Parse a package list, rejecting anything rpm could not have written."""
    pkgs = {}
    for num, line in enumerate(text.splitlines(), 1):
        if not line:
            continue
        m = LINE_RE.fullmatch(line)
        if not m:
            die(f"{source}: line {num} is not a valid package entry: {line!r}")
        # Install-only packages (e.g. kernel) can be listed more than once.
        pkgs.setdefault(m["name"], []).append(m["evr"])
    if not pkgs:
        die(f"{source}: empty package list")
    return {name: ", ".join(sorted(evrs)) for name, evrs in pkgs.items()}


def decode_label(encoded):
    """base64 + gzip, with the decompressed size capped at MAX_LIST."""
    if len(encoded) > MAX_ENCODED:
        die(f"the {LABEL} label is too large ({len(encoded)} bytes)")
    try:
        raw = base64.b64decode(encoded, validate=True)
        # 16 + MAX_WBITS accepts the gzip format only.
        d = zlib.decompressobj(16 + zlib.MAX_WBITS)
        data = d.decompress(raw, MAX_LIST)
    except (binascii.Error, zlib.error) as e:
        die(f"cannot decode the {LABEL} label: {e}")
    if d.unconsumed_tail:
        die(f"the {LABEL} label expands to more than {MAX_LIST} bytes")
    if not d.eof or d.unused_data:
        die(f"the {LABEL} label is not a single complete gzip stream")
    try:
        return data.decode("ascii")
    except UnicodeDecodeError:
        die(f"the {LABEL} label contains non-ASCII data")


def verify(ref, digest):
    """Check the cosign signature of repo@digest.

    Returns None if verified, otherwise the reason it was not checked.
    Exits if verification fails.
    """
    if not ref.startswith("docker://"):
        return "not a registry image"
    cosign = shutil.which("cosign")
    if not cosign:
        return "cosign not found"
    target = f"{repository(ref)}@{digest}"
    try:
        result = subprocess.run(
            [cosign, "verify", "--key", COSIGN_KEY, target],
            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True,
        )
    except OSError as e:
        die(f"cannot run cosign: {e}")
    if result.returncode != 0:
        sys.stderr.write(clean(result.stderr.strip()) + "\n")
        die(f"signature verification failed for {target}; "
            "not showing its package list")
    return None


def main(argv):
    if len(argv) > 2 or (len(argv) == 2 and argv[1] in ("-h", "--help")):
        print(__doc__.strip())
        return 0 if len(argv) == 2 else 2

    if len(argv) == 2:
        ref = to_skopeo_ref(argv[1])
    else:
        ref = to_skopeo_ref(booted_image_ref())
        if "@sha256:" in ref:
            die(f"the booted image is pinned to a digest ({ref}), so it has "
                "no newer version; pass a tag explicitly")

    try:
        with open(LOCAL_LIST, encoding="ascii") as f:
            local = parse(f.read(), LOCAL_LIST)
    except (OSError, UnicodeDecodeError) as e:
        die(f"cannot read the booted package list: {e}")

    try:
        out = subprocess.run(
            ["skopeo", "inspect", "--no-tags", ref],
            check=True, stdout=subprocess.PIPE, text=True,
        ).stdout
    except OSError as e:
        die(f"cannot run skopeo: {e}")
    except subprocess.CalledProcessError:
        die(f"skopeo inspect {ref} failed")
    info = json.loads(out)

    # The digest is what gets verified, so it has to be well-formed.
    digest = info.get("Digest", "")
    if not isinstance(digest, str) or not DIGEST_RE.fullmatch(digest):
        die(f"skopeo returned an invalid digest: {digest!r}")

    encoded = (info.get("Labels") or {}).get(LABEL)
    if not encoded or not isinstance(encoded, str):
        die(f"{ref} has no {LABEL} label (built before package labels "
            "were added?)")

    # Verify before decoding, so an unsigned label is never parsed or shown.
    unverified = verify(ref, digest)
    remote = parse(decode_label(encoded), f"{LABEL} label")

    print(f"Image:     {clean(ref)}")
    print(f"Digest:    {digest}")
    print(f"Created:   {clean(info.get('Created', 'unknown'))}")
    if unverified is None:
        print(f"Signature: verified with {COSIGN_KEY}")
    else:
        print(f"Signature: NOT VERIFIED ({unverified}); "
              "the package list below could be forged")
        if ref.startswith("docker://"):
            print(f"           check with: cosign verify --key {COSIGN_KEY} "
                  f"{clean(repository(ref))}@{digest}")

    changed = sorted(n for n in local.keys() & remote.keys()
                     if local[n] != remote[n])
    removed = sorted(local.keys() - remote.keys())
    added = sorted(remote.keys() - local.keys())

    if not (changed or removed or added):
        print("No package changes.")
        return 0

    if changed:
        print(f"Changed ({len(changed)}):")
        for n in changed:
            print(f"  {n} {local[n]} -> {remote[n]}")
    if removed:
        print(f"Removed ({len(removed)}):")
        for n in removed:
            print(f"  {n} {local[n]}")
    if added:
        print(f"Added ({len(added)}):")
        for n in added:
            print(f"  {n} {remote[n]}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
